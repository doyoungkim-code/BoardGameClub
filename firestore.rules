rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 오너 이메일은 src/lib/constants.ts 의 OWNER_EMAIL 과 같아야 한다
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'kwat09k@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isApproved(uid) {
      return exists(userPath(uid)) && get(userPath(uid)).data.status == 'approved';
    }

    function isMember() {
      return signedIn() && isApproved(request.auth.uid);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function unchangedOrNow(field) {
      return request.resource.data[field] == resource.data[field]
        || request.resource.data[field] == request.time;
    }

    function validNickname(v) {
      return v is string && v.size() >= 1 && v.size() <= 20;
    }

    function validReferrerName(v) {
      return v is string && v.size() <= 30;
    }

    // ---------- users: 공개 프로필 ----------

    match /users/{uid} {
      // 승인 전에는 본인 문서만. 승인된 회원과 오너는 전체.
      allow read: if isSelf(uid) || isMember() || isOwner();

      allow create: if isSelf(uid) && validNewUser();

      // 본인은 닉네임·사진·최근 활동일만, 오너는 상태·승인일·소개자 연결만 바꿀 수 있다
      allow update: if (isSelf(uid) && validSelfUpdate())
        || (isOwner() && validOwnerUpdate(uid));

      // 삭제를 막아서 거절·강퇴된 계정이 다시 신청하지 못하게 한다
      allow delete: if false;

      function validNewUser() {
        let d = request.resource.data;
        let keys = ['nickname', 'googleName', 'photoURL', 'role', 'status',
                    'referrerName', 'referrerId', 'createdAt', 'approvedAt', 'lastActiveAt'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && validNickname(d.nickname)
          && d.googleName is string
          && (d.photoURL == null || d.photoURL is string)
          && validReferrerName(d.referrerName)
          && d.referrerId == null
          && d.createdAt == request.time
          && d.lastActiveAt == request.time
          && (
            // 일반 신청: 대기 상태 + 소개자 이름 필수
            (d.role == 'member' && d.status == 'pending' && d.approvedAt == null && d.referrerName.size() >= 1)
            // 오너 계정: 바로 승인
            || (isOwner() && d.role == 'owner' && d.status == 'approved' && d.approvedAt == request.time)
          );
      }

      function validSelfUpdate() {
        let d = request.resource.data;
        return changedOnly(['nickname', 'photoURL', 'googleName', 'lastActiveAt'])
          && validNickname(d.nickname)
          && (d.photoURL == null || d.photoURL is string)
          && d.googleName is string
          && unchangedOrNow('lastActiveAt');
      }

      function validOwnerUpdate(uid) {
        let d = request.resource.data;
        return changedOnly(['status', 'approvedAt', 'referrerId'])
          && d.status in ['pending', 'approved', 'rejected', 'removed']
          // 오너 자신의 상태는 바꿀 수 없다
          && (uid != request.auth.uid || d.status == resource.data.status)
          && (d.referrerId == null
              || (d.referrerId is string && d.referrerId != uid && exists(userPath(d.referrerId))))
          && unchangedOrNow('approvedAt');
      }
    }

    // ---------- userPrivate: 이메일 등 본인·오너만 보는 정보 ----------

    match /userPrivate/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ---------- 채팅 공통 ----------

    // 메시지를 보낼 때 같은 batch로 방의 마지막 메시지 정보만 갱신
    function validLastMessageUpdate() {
      let d = request.resource.data;
      return changedOnly(['lastMessageAt', 'lastMessagePreview', 'lastSenderId'])
        && d.lastMessageAt == request.time
        && d.lastSenderId == request.auth.uid
        && d.lastMessagePreview is string
        && d.lastMessagePreview.size() <= 100;
    }

    function validNewMessage() {
      let d = request.resource.data;
      let keys = ['senderId', 'senderNickname', 'text', 'createdAt', 'deleted'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.senderId == request.auth.uid
        && validNickname(d.senderNickname)
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 2000
        && d.createdAt == request.time
        && d.deleted == false;
    }

    // 메시지는 지우지 않고 내용만 비운다(삭제 표시)
    function validMessageSoftDelete() {
      return changedOnly(['deleted', 'text'])
        && request.resource.data.deleted == true
        && request.resource.data.text == '';
    }

    // 마지막 메시지를 삭제했을 때 목록에 남는 미리보기만 지운다 (시각·보낸사람은 그대로)
    function validPreviewClear() {
      return changedOnly(['lastMessagePreview'])
        && request.resource.data.lastMessagePreview == '삭제된 메시지';
    }

    // ---------- channels: 단체 채팅방 ----------

    match /channels/{channelId} {
      allow read: if isMember();
      allow create: if isOwner() && validNewChannel();
      allow update: if (isOwner() && changedOnly(['name', 'description', 'order']) && validChannelFields())
        || (isMember() && validLastMessageUpdate())
        // 마지막 메시지를 지울 수 있는 사람(보낸 사람, 오너)만 미리보기도 지운다
        || (isMember() && validPreviewClear()
            && (resource.data.lastSenderId == request.auth.uid || isOwner()));
      allow delete: if isOwner();

      function validChannelFields() {
        let d = request.resource.data;
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 30
          && d.description is string && d.description.size() <= 100
          && d.order is int;
      }

      function validNewChannel() {
        let d = request.resource.data;
        let keys = ['name', 'description', 'order', 'createdAt', 'createdBy',
                    'lastMessageAt', 'lastMessagePreview', 'lastSenderId'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && validChannelFields()
          && d.createdAt == request.time
          && d.createdBy == request.auth.uid
          && d.lastMessageAt == null
          && d.lastMessagePreview == ''
          && d.lastSenderId == null;
      }

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember() && validNewMessage();
        // 보낸 사람 본인 또는 오너가 삭제 표시
        allow update: if isMember()
          && (resource.data.senderId == request.auth.uid || isOwner())
          && validMessageSoftDelete();
        allow delete: if false;
      }
    }

    // ---------- dms: 1:1 대화 (문서 ID = 두 uid를 정렬해 '_'로 연결) ----------

    function isDmParticipant(dmId) {
      return isMember() && request.auth.uid in dmId.split('_');
    }

    match /dms/{dmId} {
      // 없는 방도 조회할 수 있어야 '있으면 열고 없으면 만들기'가 가능하다
      allow get: if isDmParticipant(dmId);
      allow list: if isMember() && request.auth.uid in resource.data.memberIds;
      allow create: if isDmParticipant(dmId) && validNewDm(dmId);
      allow update: if isDmParticipant(dmId)
        && (validLastMessageUpdate()
            || (validPreviewClear() && resource.data.lastSenderId == request.auth.uid));
      allow delete: if false;

      function validNewDm(dmId) {
        let d = request.resource.data;
        let keys = ['memberIds', 'createdAt', 'lastMessageAt', 'lastMessagePreview', 'lastSenderId'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && d.memberIds is list && d.memberIds.size() == 2
          && d.memberIds[0] < d.memberIds[1]
          && dmId == d.memberIds[0] + '_' + d.memberIds[1]
          && request.auth.uid in d.memberIds
          && isApproved(d.memberIds[0]) && isApproved(d.memberIds[1])
          && d.createdAt == request.time
          && d.lastMessageAt == null
          && d.lastMessagePreview == ''
          && d.lastSenderId == null;
      }

      match /messages/{messageId} {
        allow read: if isDmParticipant(dmId);
        allow create: if isDmParticipant(dmId)
          && exists(/databases/$(database)/documents/dms/$(dmId))
          && validNewMessage();
        allow update: if isDmParticipant(dmId)
          && resource.data.senderId == request.auth.uid
          && validMessageSoftDelete();
        allow delete: if false;
      }
    }

    // ---------- events: 정기모임·번개 ----------

    match /events/{eventId} {
      allow read: if isMember();
      allow create: if isMember() && validNewEvent();
      allow update: if isMember() && (
        // 호스트·오너: 내용 수정 / 출석 체크
        (isHostOrOwner() && (validEventEdit() || validAttendedUpdate()))
        // 회원 누구나: 본인 참석 신청·취소
        || validAttendToggle()
      );
      allow delete: if isMember() && isHostOrOwner();

      function isHostOrOwner() {
        return resource.data.hostId == request.auth.uid || isOwner();
      }

      function validEventFields() {
        let d = request.resource.data;
        return d.title is string && d.title.size() >= 1 && d.title.size() <= 50
          && d.description is string && d.description.size() <= 1000
          && d.location is string && d.location.size() <= 100
          && d.startAt is timestamp
          && (d.endAt == null || (d.endAt is timestamp && d.endAt > d.startAt))
          && (d.capacity == null || (d.capacity is int && d.capacity >= 1 && d.capacity <= 100))
          && d.gameIds is list && d.gameIds.size() <= 20
          && d.canceled is bool;
      }

      function validNewEvent() {
        let d = request.resource.data;
        let keys = ['type', 'title', 'description', 'location', 'startAt', 'endAt', 'capacity',
                    'hostId', 'gameIds', 'attendeeIds', 'attendedIds', 'canceled', 'createdAt'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && validEventFields()
          // 정기모임은 오너만, 번개는 승인된 회원 누구나
          && (d.type == 'flash' || (d.type == 'regular' && isOwner()))
          && d.hostId == request.auth.uid
          // 만든 사람은 자동으로 참석
          && d.attendeeIds == [request.auth.uid]
          && d.attendedIds == []
          && d.canceled == false
          && d.createdAt == request.time;
      }

      function validEventEdit() {
        let d = request.resource.data;
        return changedOnly(['title', 'description', 'location', 'startAt', 'endAt',
                            'capacity', 'gameIds', 'canceled'])
          && validEventFields()
          // 정원을 이미 참석 중인 인원보다 적게 줄일 수 없다
          && (d.capacity == null || d.capacity >= resource.data.attendeeIds.size());
      }

      // 출석 체크는 참석자 중에서만 고를 수 있다
      function validAttendedUpdate() {
        return changedOnly(['attendedIds'])
          && request.resource.data.attendedIds is list
          && request.resource.data.attendedIds.hasOnly(resource.data.attendeeIds);
      }

      // 참석 신청·취소: 본인 uid 하나만 넣거나 뺀다
      function validAttendToggle() {
        let me = request.auth.uid;
        let before = resource.data.attendeeIds;
        let after = request.resource.data.attendeeIds;
        return changedOnly(['attendeeIds'])
          && after is list
          && resource.data.canceled == false
          && (
            // 신청: 정원을 넘지 않을 때만
            (!(me in before)
              && after.size() == before.size() + 1
              && after.toSet() == before.toSet().union([me].toSet())
              && (resource.data.capacity == null || after.size() <= resource.data.capacity))
            // 취소
            || (me in before
              && after.size() == before.size() - 1
              && after.toSet() == before.toSet().difference([me].toSet()))
          );
      }
    }

    // ---------- games: 보드게임 라이브러리 ----------

    match /games/{gameId} {
      allow read: if isMember();
      allow create: if isMember() && validNewGame();
      allow update: if isMember() && (
        // 등록자·오너: 내용 수정
        (isEditor() && validGameEdit())
        // 회원 누구나: 빌리기 / 반납
        || validBorrowChange()
      );
      allow delete: if isMember() && isEditor();

      function isEditor() {
        return resource.data.createdBy == request.auth.uid || isOwner();
      }

      function validGameFields() {
        let d = request.resource.data;
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && d.altName is string && d.altName.size() <= 60
          && d.minPlayers is int && d.minPlayers >= 1 && d.minPlayers <= 99
          && d.maxPlayers is int && d.maxPlayers >= d.minPlayers && d.maxPlayers <= 99
          && (d.playTimeMin == null || (d.playTimeMin is int && d.playTimeMin >= 1 && d.playTimeMin <= 1440))
          && (d.weight == null || (d.weight is int && d.weight >= 1 && d.weight <= 5))
          && d.tags is list && d.tags.size() <= 10
          && d.description is string && d.description.size() <= 1000
          && d.bggUrl is string && d.bggUrl.size() <= 200
          // 동호회 공용이면 소유자가 없고, 개인 소장이면 회원 한 명을 가리킨다
          && ((d.ownership == 'club' && d.ownerId == null)
              || (d.ownership == 'member' && d.ownerId is string && isApproved(d.ownerId)));
      }

      function validNewGame() {
        let d = request.resource.data;
        let keys = ['name', 'altName', 'minPlayers', 'maxPlayers', 'playTimeMin', 'weight', 'tags',
                    'description', 'bggUrl', 'ownership', 'ownerId', 'borrowerId', 'borrowedAt',
                    'createdBy', 'createdAt'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && validGameFields()
          && d.borrowerId == null
          && d.borrowedAt == null
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
      }

      function validGameEdit() {
        return changedOnly(['name', 'altName', 'minPlayers', 'maxPlayers', 'playTimeMin', 'weight',
                            'tags', 'description', 'bggUrl', 'ownership', 'ownerId'])
          && validGameFields();
      }

      // 빌리기는 비어 있을 때 본인 이름으로만, 반납은 빌린 본인·소유자·등록자·오너가 할 수 있다
      function validBorrowChange() {
        let me = request.auth.uid;
        let d = request.resource.data;
        return changedOnly(['borrowerId', 'borrowedAt'])
          && (
            (resource.data.borrowerId == null && d.borrowerId == me && d.borrowedAt == request.time)
            || (resource.data.borrowerId != null && d.borrowerId == null && d.borrowedAt == null
                && (resource.data.borrowerId == me || resource.data.ownerId == me || isEditor()))
          );
      }
    }

    // ---------- posts: 공지·자유·후기 게시판 ----------

    match /posts/{postId} {
      allow read: if isMember();
      allow create: if isMember() && validNewPost();
      allow update: if isMember() && (
        // 글쓴이·오너: 내용 수정
        (isAuthorOrOwner() && validPostEdit())
        // 오너: 고정 설정
        || (isOwner() && changedOnly(['pinned']) && request.resource.data.pinned is bool)
        // 회원 누구나: 좋아요 토글
        || validLikeToggle()
        // 댓글을 쓰거나 지울 때 같은 batch 로 개수만 갱신
        || validCommentCountChange()
      );
      allow delete: if isMember() && isAuthorOrOwner();

      function isAuthorOrOwner() {
        return resource.data.authorId == request.auth.uid || isOwner();
      }

      function validPostFields() {
        let d = request.resource.data;
        return d.board in ['notice', 'free', 'review']
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
          && d.content is string && d.content.size() >= 1 && d.content.size() <= 10000;
      }

      function validNewPost() {
        let d = request.resource.data;
        let keys = ['board', 'title', 'content', 'authorId', 'authorNickname', 'pinned',
                    'likeIds', 'commentCount', 'createdAt', 'updatedAt'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && validPostFields()
          // 공지는 오너만 쓴다
          && (d.board != 'notice' || isOwner())
          && d.authorId == request.auth.uid
          && validNickname(d.authorNickname)
          // 고정은 오너만 걸 수 있다
          && (d.pinned == false || isOwner())
          && d.likeIds == []
          && d.commentCount == 0
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }

      function validPostEdit() {
        // 게시판 이동은 막는다 (공지 권한 우회 방지)
        return changedOnly(['title', 'content', 'updatedAt'])
          && validPostFields()
          && request.resource.data.updatedAt == request.time;
      }

      function validLikeToggle() {
        let me = request.auth.uid;
        let before = resource.data.likeIds;
        let after = request.resource.data.likeIds;
        return changedOnly(['likeIds'])
          && after is list
          && (
            (!(me in before) && after.size() == before.size() + 1
              && after.toSet() == before.toSet().union([me].toSet()))
            || (me in before && after.size() == before.size() - 1
              && after.toSet() == before.toSet().difference([me].toSet()))
          );
      }

      function validCommentCountChange() {
        let before = resource.data.commentCount;
        let after = request.resource.data.commentCount;
        return changedOnly(['commentCount'])
          && after is int
          && (after == before + 1 || (after == before - 1 && after >= 0));
      }

      match /comments/{commentId} {
        allow read: if isMember();
        allow create: if isMember() && validNewComment();
        allow update: if isMember()
          && resource.data.authorId == request.auth.uid
          && changedOnly(['content'])
          && validCommentContent();
        // 댓글은 지운 흔적을 남기지 않고 문서를 삭제한다 (글쓴이 본인과 오너)
        allow delete: if isMember()
          && (resource.data.authorId == request.auth.uid || isOwner());

        function validCommentContent() {
          let c = request.resource.data.content;
          return c is string && c.size() >= 1 && c.size() <= 2000;
        }

        function validNewComment() {
          let d = request.resource.data;
          let keys = ['authorId', 'authorNickname', 'content', 'createdAt'];
          return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
            && d.authorId == request.auth.uid
            && validNickname(d.authorNickname)
            && validCommentContent()
            && d.createdAt == request.time;
        }
      }
    }

    // ---------- adminMemos: 오너만 보는 회원 메모 ----------

    match /adminMemos/{uid} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['memo', 'updatedAt'])
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 1000
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- readStates: 방별 마지막으로 읽은 시각 (안 읽음 표시용) ----------

    match /users/{uid}/readStates/{roomKey} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt == request.time;
    }
  }
}
